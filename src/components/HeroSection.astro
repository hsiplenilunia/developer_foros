</section>
<script>
  let transitionInterval;
  let isWomanVisible = true;
  let switchCount = 0;
  
  const MAX_SWITCHES = 10; // 5 vueltas completas (Ida y vuelta)
  const TRANSITION_TIME = 4000; // 4 segundos por elemento

  const layerWoman = document.getElementById("hero-layer-woman");
  const layerVideo = document.getElementById("hero-layer-video");

  // 1. Iniciar la transición normal apenas cargue la página
  function startLayoutTransition() {
    if (!layerWoman || !layerVideo) return;

    transitionInterval = setInterval(() => {
      if (isWomanVisible) {
        // Mostrar Video
        layerWoman.classList.remove("opacity-100", "scale-100");
        layerWoman.classList.add("opacity-0", "scale-95", "pointer-events-none");

        layerVideo.classList.remove("opacity-0", "scale-95", "pointer-events-none");
        layerVideo.classList.add("opacity-100", "scale-100");
      } else {
        // Mostrar Chica
        layerVideo.classList.remove("opacity-100", "scale-100");
        layerVideo.classList.add("opacity-0", "scale-95", "pointer-events-none");

        layerWoman.classList.remove("opacity-0", "scale-95", "pointer-events-none");
        layerWoman.classList.add("opacity-100", "scale-100");
      }

      isWomanVisible = !isWomanVisible;
      switchCount++;

      if (switchCount >= MAX_SWITCHES) {
        clearInterval(transitionInterval);
      }
    }, TRANSITION_TIME);
  }

  // 2. Cargar la API de YouTube en segundo plano
  const tag = document.createElement('script');
  tag.src = "https://www.youtube.com/iframe_api";
  const firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

  // 3. Escuchar los eventos del reproductor de YouTube
  // Forzamos el tipado en window para que Astro no lo aísle del contexto global
  (window as any).onYouTubeIframeAPIReady = () => {
    new (window as any).YT.Player('youtube-player', {
      events: {
        'onStateChange': (event: any) => {
          // El estado '1' significa YT.PlayerState.PLAYING (El usuario le dio Play)
          if (event.data === 1) {
            // Detener el cronómetro para siempre
            clearInterval(transitionInterval);
            
            // Forzar que el video se quede visible y la chica oculta inmediatamente
            layerWoman?.classList.remove("opacity-100", "scale-100");
            layerWoman?.classList.add("opacity-0", "scale-95", "pointer-events-none");

            layerVideo?.classList.remove("opacity-0", "scale-95", "pointer-events-none");
            layerVideo?.classList.add("opacity-100", "scale-100");
            
            console.log("▶️ Video en reproducción: Transición pausada permanentemente.");
          }
        }
      }
    });
  };

  // Arrancar el ciclo de animación al cargar la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startLayoutTransition);
  } else {
    startLayoutTransition();
  }
</script>